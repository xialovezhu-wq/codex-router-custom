{
  "version": 1,
  "providers": [
    {
      "id": "xiaomi-mimo-payg",
      "displayName": "Xiaomi MiMo Official API",
      "kind": "openai-compatible",
      "ownedBy": "xiaomi",
      "protocol": "openai-responses",
      "baseUrl": "https://api.xiaomimimo.com/v1",
      "credential": {
        "environment": ["MIMO_API_KEY"],
        "file": "xiaomi-mimo-payg-api-key.secret",
        "legacyFiles": [],
        "keychainServices": ["codex-router-xiaomi-mimo-payg"],
        "prompt": "Xiaomi MiMo pay-as-you-go API key"
      }
    }
  ]
}
